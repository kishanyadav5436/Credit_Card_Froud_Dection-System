# Database Connection URL (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/fraudguard

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Authentication & Security
SECRET_KEY=your-super-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=30
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email delivery
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# ── ML Hybrid Engine Weights ──────────────────────────────────────────────────
# final_score = rule_score * RULE_WEIGHT + ml_score * ML_WEIGHT
# Must effectively sum to 1.0 (values are applied independently)
RULE_WEIGHT=0.4
ML_WEIGHT=0.6

# ── Decision Thresholds ───────────────────────────────────────────────────────
# 0 to APPROVE_THRESHOLD     -> APPROVE
# APPROVE_THRESHOLD to BLOCK_THRESHOLD -> REVIEW
# BLOCK_THRESHOLD to 100     -> BLOCK
APPROVE_THRESHOLD=30.0
BLOCK_THRESHOLD=70.0

# ── Alert Threshold ───────────────────────────────────────────────────────────
# Transactions with risk_score >= ALERT_THRESHOLD will trigger an alert
ALERT_THRESHOLD=60.0

# ── LLM Explanation Service (OPTIONAL) ───────────────────────────────────────
# If set, enables AI-generated analyst explanations.
# The LLM NEVER makes the fraud decision — it only generates narratives.
# Supports Google Gemini (install: pip install google-generativeai)
# or OpenAI (install: pip install openai).
# Leave empty to use template-based explanations (always works).
AI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# SECURITY RULES:
# - NEVER store CVV or raw card numbers (PANs) — use tokens only
# - NEVER commit this file to git (it is in .gitignore)
# - NEVER hardcode API keys in source code
# - Rotate SECRET_KEY if it is ever exposed
